---
import { CONTACT_CHANNELS } from '../lib/contact';

const links = [
  { href: '#case-file', label: 'Caso real' },
  { href: '#services', label: 'Servicios' },
  { href: '#method', label: 'Cómo entregamos' },
  { href: '#principles', label: 'Criterios' },
];

---

<header class="site-header" id="top">
  <div class="site-header__inner">
    <a class="site-brand" href="#top" aria-label="GoDigital, ir al inicio">
      <img class="site-brand__logo" src="/logo-dark.svg" alt="" width="128" height="38" style="object-fit: cover;" />
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a
      class="header-contact"
      href={CONTACT_CHANNELS.whatsapp.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Hablar con GoDigital por WhatsApp, abre en una pestaña nueva"
    >
      Hablar por WhatsApp
      <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-nav" id="mobile-nav">
      <summary aria-label="Abrir navegación">
        <span class="mobile-nav__label">Menú</span>
        <span class="menu-mark" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </summary>

      <div class="mobile-menu">
        <p class="document-label">Índice del proyecto</p>
        <nav aria-label="Navegación móvil">
          <ul>
            {links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
            <li><a href="#contact">Contacto</a></li>
          </ul>
        </nav>
        <a
          class="button button--primary mobile-menu__contact"
          href={CONTACT_CHANNELS.whatsapp.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Hablar con GoDigital por WhatsApp, abre en una pestaña nueva"
        >
          Hablar por WhatsApp
          <span aria-hidden="true">↗</span>
        </a>
        <a class="mobile-menu__email" href={CONTACT_CHANNELS.email.projectHref}>
          {CONTACT_CHANNELS.email.address}
        </a>
      </div>
    </details>
  </div>
</header>
