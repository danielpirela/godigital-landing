---
const links = [
  { href: '#services', label: 'Servicios' },
  { href: '#edge', label: 'Diferencia' },
  { href: '#process', label: 'Proceso' },
  { href: '#cta', label: 'Contacto' },
];
---

<nav
  id="navbar"
  class="navbar fixed top-0 left-0 right-0 z-50 px-[var(--margin-mobile)] md:px-[var(--margin-desktop)] transition-all duration-300"
>
  <!-- Progress bar at very top of navbar -->
  <div class="navbar-progress absolute top-0 left-0 h-[2px] bg-electric-blue shadow-[0_0_8px_rgba(var(--color-electric-blue-rgb),0.8)] origin-left" style="width: 0%;"></div>

  <div
    class="mx-auto flex items-center justify-between py-3 md:py-4"
    style="max-width: var(--container-max)"
  >
    <!-- Logo -->
    <a href="#hero" class="navbar-logo flex items-center shrink-0">
      <img
        src="/logo-dark.svg"
        alt="GoDigital"
        class="h-8 md:h-10 w-auto transition-all duration-300"
        style="view-transition-name: logo;"
      />
    </a>

    <!-- Desktop nav links -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="navbar-link text-sm font-medium text-on-surface-variant hover:text-on-surface transition-colors duration-200 relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Hamburger button (mobile) — CSS-animated to X -->
    <button
      id="nav-toggle"
      type="button"
      class="md:hidden relative flex flex-col gap-1.5 p-2 bg-transparent border-none cursor-pointer z-10"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-line block w-6 h-[2px] bg-on-surface rounded-full origin-center"></span>
      <span class="hamburger-line block w-6 h-[2px] bg-on-surface rounded-full origin-center"></span>
      <span class="hamburger-line block w-6 h-[2px] bg-on-surface rounded-full origin-center"></span>
    </button>
  </div>

  <!-- Mobile menu overlay — CSS-driven, no inline styles -->
  <div
    id="mobile-menu"
    class="mobile-menu md:hidden"
    aria-hidden="true"
  >
    <div class="mobile-menu-inner">
      {links.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  /* ── Navbar state classes driven by scrollTrigger ────────────────── */
  .navbar {
    background: transparent;
    border-bottom: 0px solid transparent;
  }

  .navbar.scrolled {
    background: rgba(8, 10, 16, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .navbar.compact {
    background: rgba(0, 102, 255, 0.15);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(0, 102, 255, 0.3);
  }

  .navbar.compact .navbar-logo img {
    height: 32px !important;
    filter: drop-shadow(0 0 8px rgba(0, 102, 255, 0.6));
  }

  /* ── Mobile menu — CSS-driven open/close (no inline styles) ──────── */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: var(--margin-mobile);
    right: var(--margin-mobile);
    z-index: 60;
    background: rgba(8, 10, 16, 0.92);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    overflow: hidden;
    /* Closed state */
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      max-height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.35s;
  }

  .mobile-menu.is-open {
    max-height: 400px;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease 0.05s,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-surface-variant, #c2c6d8);
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
    cursor: pointer;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: var(--color-on-surface, #e1e2e8);
    background: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  /* ── Hamburger → X rotation (CSS, works everywhere) ──────────────── */
  #nav-toggle .hamburger-line {
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.15s ease;
  }

  #nav-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }
  #nav-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #nav-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }
</style>

<script>
  (function initNavbar() {
    const navbar = document.getElementById('navbar');
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    const progressBar = navbar?.querySelector('.navbar-progress') as HTMLElement | null;

    if (!navbar) return;

    // Capture non-null reference (TS narrowing only applies to the function scope)
    const nav = navbar;

    // ── 3-state morph via scroll (transparent → glass → compact) ──────
    function updateNavbarState() {
      const scrollY = window.scrollY;
      const heroBottom = document.getElementById('hero')?.getBoundingClientRect().bottom ?? 0;
      const heroProgress = heroBottom > 0 ? 0 : Math.min(1, -heroBottom / window.innerHeight);

      nav.classList.remove('scrolled', 'compact');
      if (heroProgress > 0.7) nav.classList.add('compact');
      else if (heroProgress > 0.15 || scrollY > 100) nav.classList.add('scrolled');
    }

    let scrollTicking = false;
    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        requestAnimationFrame(() => {
          updateNavbarState();
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    }, { passive: true });
    updateNavbarState();

    // ── Mobile menu toggle (CSS-driven) ────────────────────────────────
    function setMenuOpen(open: boolean) {
      if (!menu || !toggle) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      menu.setAttribute('aria-hidden', String(!open));
      menu.classList.toggle('is-open', open);
    }

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    // Close menu when a link is clicked
    menu?.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        setMenuOpen(false);
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!menu || !toggle) return;
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (
        isOpen &&
        !toggle.contains(e.target as Node) &&
        !menu.contains(e.target as Node)
      ) {
        setMenuOpen(false);
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggle?.focus();
      }
    });

    // Close menu if viewport resizes to desktop
    const mql = window.matchMedia('(min-width: 768px)');
    mql.addEventListener('change', (e) => {
      if (e.matches) setMenuOpen(false);
    });

    // ── Progress bar sync via godigital:scroll event ───────────────────
    document.addEventListener('godigital:scroll', (e: Event) => {
      if (!progressBar) return;
      const detail = (e as CustomEvent).detail;
      progressBar.style.width = `${detail.percent}%`;
    });
  })();
</script>
