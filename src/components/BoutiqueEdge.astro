---

<section
  id="boutique-edge"
  class="relative px-[var(--margin-mobile)] md:px-[var(--margin-desktop)] pb-30"
>
  <div class="mx-auto" style="max-width: var(--container-max);">
    <!-- Section header -->
    <div class="text-center mb-16 md:mb-20" data-reveal="section-title">
      <span class="inline-block text-xs font-semibold uppercase tracking-[0.2em] text-primary mb-4">
        Diferenciadores
      </span>
      <h2 class="text-3xl md:text-5xl font-bold">
        Lo que nos <span class="text-primary">diferencia</span>
      </h2>
      <div class="gradient-line w-16 mx-auto mt-6"></div>
    </div>

    <!-- Pillar cards — 4-col grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
      {pillars.map((pillar, i) => (
        <GlassCard variant="soft" padding="md" class="boutique-pillar" data-reveal="edge-card" data-index={i}>
          <!-- Sparkles icon -->
          <div class="pillar-icon-wrap w-10 h-10 rounded-full flex items-center justify-center mb-4" style="background: rgba(0, 102, 255, 0.12);">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-primary)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
              <path d="M20 3v4"/>
              <path d="M22 5h-4"/>
              <path d="M4 17v2"/>
              <path d="M5 18H3"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2" style="font-family: var(--font-heading);">{pillar.title}</h3>
          <p class="text-sm leading-relaxed" style="opacity: 0.7; color: var(--color-on-surface-variant);">{pillar.desc}</p>
        </GlassCard>
      ))}
    </div>
  </div>
</section>

<style>
  .boutique-pillar {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .boutique-pillar.is-revealed {
    clip-path: inset(0 0% 0 0);
  }
</style>

<script>
  // BoutiqueEdge scroll-driven animations
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBoutiqueEdge(): void {
    // Clip-path reveal from left, staggered
    const cards = gsap.utils.toArray<HTMLElement>('.boutique-pillar');
    cards.forEach((card, i) => {
      ScrollTrigger.create({
        trigger: card,
        start: 'top 80%',
        onEnter: () => {
          gsap.to(card, {
            clipPath: 'inset(0 0% 0 0)',
            duration: 0.7,
            ease: 'power3.out',
            delay: i * 0.2,
          });
          // Sparkles icon pop-in with overshoot
          const icon = card.querySelector('.pillar-icon-wrap') as HTMLElement | null;
          if (icon) {
            gsap.fromTo(
              icon,
              { scale: 0, opacity: 0 },
              {
                scale: 1,
                opacity: 1,
                duration: 0.6,
                ease: 'elastic.out(1, 0.5)',
                delay: i * 0.2 + 0.1,
              }
            );
          }
        },
        once: true,
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initBoutiqueEdge);
</script>