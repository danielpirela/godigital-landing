---
/**
 * BoutiqueEdge.astro — v2 Differentiators with 4 pillars
 *
 * 4 pillars: Integridad, Calidez, Planificación estratégica, Soporte post-lanzamiento
 * - mmx icons for integrity and support pillars
 * - Pop-in check circles with overshoot on scroll-into-view
 * - Clip-path reveal from left, staggered 0.2s
 */
import { getMmxAsset } from '../lib/mmx-assets';

const edges = [
  {
    title: 'Integridad',
    desc: 'Transparencia total en cada proyecto. Sin letra chica, sin sobrecostos ocultos. Lo que pactamos es lo que entregamos, con la calidad que prometemos.',
    iconId: 'icon-integridad',
    iconFallback: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>`,
  },
  {
    title: 'Calidez',
    desc: 'Te tratamos como persona, no como ticket. Comunicación directa, cercana y en tu idioma. Porque detrás de cada proyecto hay un ser humano.',
    iconId: null,
    iconFallback: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>`,
  },
  {
    title: 'Planificación estratégica',
    desc: 'Cada proyecto arranca con un roadmap claro. Fechas, entregables y objetivos definidos desde el día uno. Sin sorpresas de último minuto.',
    iconId: null,
    iconFallback: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="20" x2="12" y2="10"/>
      <line x1="18" y1="20" x2="18" y2="4"/>
      <line x1="6" y1="20" x2="6" y2="16"/>
    </svg>`,
  },
  {
    title: 'Soporte post-lanzamiento',
    desc: 'No desaparece la producción. Monitoreo, correcciones y mejoras continuas para que tu plataforma seguir funcionando al más alto nivel.',
    iconId: 'icon-soporte',
    iconFallback: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>`,
  },
];

function getEdgeIcon(iconId: string | null, fallback: string): string {
  if (!iconId) return fallback;
  const path = getMmxAsset(iconId as any);
  return `<img data-mmx-generated="${iconId}" src="${path}" alt="" loading="lazy" width="24" height="24" class="object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/>
    <span class="icon-fallback hidden" style="display:flex;color:#00e676;">${fallback}</span>`;
}
---

<section
  id="edge"
  class="relative px-[var(--margin-mobile)] md:px-[var(--margin-desktop)] pb-30"
>
  <div class="mx-auto" style="max-width: var(--container-max);">
    <!-- Section header -->
    <div class="text-center mb-16 md:mb-20" data-reveal="section-title">
      <span class="inline-block text-xs font-semibold uppercase tracking-[0.2em] text-success mb-4">
        Diferenciadores
      </span>
      <h2 class="text-3xl md:text-5xl font-bold">
        Lo que nos <span class="text-success">diferencia</span>
      </h2>
      <div class="gradient-line w-16 mx-auto mt-6"></div>
    </div>

    <!-- Edge cards — clip-path reveal from left, staggered -->
    <div class="edge-list flex flex-col gap-5 md:gap-6">
      {edges.map((edge, i) => (
        <div
          class="edge-card glass-card p-6 md:p-8 flex items-start gap-5 md:gap-6"
          data-reveal="edge-card"
          data-index={i}
        >
          <!-- Green check circle with pop-in animation -->
          <div
            class="edge-check shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-full flex items-center justify-center"
            style="background: rgba(0, 230, 118, 0.12); box-shadow: 0 0 20px rgba(0, 230, 118, 0.2);"
          >
            <!-- Check icon (SVG) -->
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#00e676"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="md:w-[26px] md:h-[26px]"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>

          <!-- Text + icon column -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2">
              <!-- Pillar icon (mmx or fallback) -->
              <div class="edge-icon text-success" set:html={getEdgeIcon(edge.iconId, edge.iconFallback)} />
              <h3 class="text-lg md:text-2xl font-bold">{edge.title}</h3>
            </div>
            <p class="text-on-surface-variant text-sm md:text-base leading-relaxed">{edge.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edge-card {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .edge-card.is-revealed {
    clip-path: inset(0 0% 0 0);
  }

  /* Pop-in check circle */
  .edge-check {
    transform: scale(0);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .edge-check.is-popped {
    transform: scale(1);
  }
</style>

<script>
  // BoutiqueEdge scroll-driven animations
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBoutiqueEdge(): void {
    // Clip-path reveal from left, staggered
    const cards = gsap.utils.toArray<HTMLElement>('.edge-card');
    cards.forEach((card, i) => {
      ScrollTrigger.create({
        trigger: card,
        start: 'top 80%',
        onEnter: () => {
          gsap.to(card, {
            clipPath: 'inset(0 0% 0 0)',
            duration: 0.7,
            ease: 'power3.out',
            delay: i * 0.2,
          });
          // Pop-in check circle with overshoot
          const check = card.querySelector('.edge-check') as HTMLElement | null;
          if (check) {
            gsap.to(check, {
              scale: 1,
              duration: 0.6,
              ease: 'elastic.out(1, 0.5)',
              delay: i * 0.2 + 0.1,
            });
          }
        },
        once: true,
      });
    });
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', initBoutiqueEdge);
</script>