---
/**
 * LoadingScreen.astro
 * Full-screen loading overlay with the brush-paint logo animation.
 * Visible on every page load, hides itself after the animation
 * completes and the page is fully loaded.
 */
import Logo from './Logo.astro';
---

<div id="loading-screen" class="loading-screen" aria-hidden="true">
  <div class="loading-screen__glow" aria-hidden="true"></div>
  <Logo class="loading-screen__logo" />
</div>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: var(--color-surface-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition:
      opacity 0.7s var(--ease-cinematic),
      visibility 0.7s var(--ease-cinematic),
      transform 0.7s var(--ease-cinematic);
  }

  .loading-screen.is-hiding {
    opacity: 0;
    visibility: hidden;
    transform: scale(1.06);
    pointer-events: none;
  }

  .loading-screen__glow {
    position: absolute;
    width: 560px;
    height: 560px;
    max-width: 90vmin;
    max-height: 90vmin;
    background: radial-gradient(
      circle at center,
      rgba(0, 102, 255, 0.22) 0%,
      rgba(0, 102, 255, 0.08) 35%,
      rgba(0, 102, 255, 0) 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .loading-screen__logo {
    height: 128px;
    width: auto;
    display: block;
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-screen.is-hiding {
      transform: none;
      transition-duration: 0.1s;
    }
  }
</style>

<script is:inline>
  (function initLoadingScreen() {
    var el = document.getElementById('loading-screen');
    if (!el) return;

    // The brush-paint animation takes ~2.85s. Show the loading screen for
    // at least 3s so the animation is fully visible, but always wait for
    // the page to be fully loaded first.
    var MIN_VISIBLE_MS = 3000;
    var start = (window.performance && performance.now)
      ? performance.now()
      : Date.now();

    var remove = function () {
      if (el && el.parentNode) el.parentNode.removeChild(el);
    };
    var hide = function () {
      el.classList.add('is-hiding');
      window.setTimeout(remove, 800);
    };
    var schedule = function () {
      var now = (window.performance && performance.now)
        ? performance.now()
        : Date.now();
      var wait = Math.max(0, MIN_VISIBLE_MS - (now - start));
      window.setTimeout(hide, wait);
    };

    if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  })();
</script>

<noscript>
  <style>
    #loading-screen { display: none !important; }
  </style>
</noscript>
