---
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden px-[var(--margin-mobile)] md:px-[var(--margin-desktop)] pt-24 pb-16"
>
  <!-- ─── Video Background Layer ─── -->
  <!--
    ENABLE_MMX_CURTAIN=true would load /assets/generated/curtain.mp4 here,
    but mmx video quota is exhausted (resets 2026-06-08). Default: CSS clip-path wipe.
    Curtain logic lives in src/scripts/animations/scroll.ts.
  -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <!-- Poster fallback (always rendered, preloaded in Layout.astro) -->
    <img
      src="/assets/generated/bg/obsidian-mesh.png"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-60"
      style="z-index: 0;"
      data-mmx-generated="bg-obsidian-mesh"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Video: desktop only (media query gates source) -->
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/assets/generated/bg/obsidian-mesh.png"
      data-mmx-generated="hero-loop"
      class="absolute inset-0 w-full h-full object-cover hidden md:block"
      style="z-index: 1;"
      aria-hidden="true"
    >
      <source src="/assets/generated/hero-loop.mp4" type="video/mp4" media="(min-width: 769px)" />
    </video>
  </div>

  <!-- ─── 3 Ambient Parallax Orbs ─── -->
  <div class="ambient-orb w-[500px] h-[500px] -top-[200px] -left-[150px] md:w-[700px] md:h-[700px] md:-top-[250px] md:-left-[200px]" data-orb="1" aria-hidden="true"></div>
  <div class="ambient-orb w-[400px] h-[400px] -bottom-[150px] -right-[100px] md:w-[600px] md:h-[600px] md:-bottom-[200px] md:-right-[150px]" data-orb="2" aria-hidden="true"></div>
  <div class="ambient-orb w-[300px] h-[300px] top-1/2 -translate-y-1/2 -left-[100px] md:w-[450px] md:h-[450px] md:-left-[150px]" data-orb="3" aria-hidden="true"></div>

  <!-- ─── Particle Container (count driven by CSS var from matchMedia) ─── -->
  <div class="hero-particles absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true"></div>

  <!-- ─── Main Content (z-10 above video + orbs) ─── -->
  <div class="relative z-10 flex flex-col items-center text-center max-w-3xl mx-auto">

    <!-- Logo -->
    <div class="hero-logo mb-6 md:mb-8">
      <img
        src="/logo-dark.svg"
        alt="GoDigital"
        class="w-40 md:w-60 lg:w-72 h-auto"
      />
    </div>

    <!-- Tagline — 2 lines for staggered clip-path reveal -->
    <h1 class="hero-tagline text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
      <span class="hero-tagline-line block">Diseño y desarrollo</span>
      <span class="hero-tagline-line block text-primary">premium</span>
    </h1>

    <!-- Subtitle + Stat Badge row -->
    <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8 mb-10 md:mb-12">
      <p class="hero-subtitle text-lg md:text-xl text-white max-w-xl mx-auto md:mx-0">
        Tu visión, nuestro código. Creamos productos digitales que potencian tu negocio con diseño impecable y tecnología de vanguardia.
      </p>
      <!-- Scroll-scrubbed counter: desktop only -->
      <div
        class="hero-counter hidden md:flex flex-col items-center text-sm text-on-surface-variant/60"
        data-counter="0"
        data-counter-target="10"
        data-counter-suffix="+"
        aria-label="10+ proyectos completados"
      >
        <span class="hero-counter-value font-bold text-electric-blue text-2xl">0+</span>
        <span class="text-xs tracking-wide">proyectos</span>
      </div>
    </div>

    <!-- CTA Buttons — magnetic attraction via data-magnetic-strength -->
    <div class="hero-cta flex flex-col sm:flex-row items-center gap-4 sm:gap-5">
      <a
        href="#cta"
        class="magnetic-btn inline-flex items-center justify-center px-8 py-3.5 rounded-[var(--radius-pill)] bg-primary text-white font-semibold text-sm md:text-base glow-primary hover:glow-primary-hover transition-all duration-300 hover:-translate-y-0.5"
        data-magnetic-strength="8"
      >
        Cotizar Proyecto
      </a>
      <a
        href="#process"
        class="magnetic-btn inline-flex items-center justify-center px-8 py-3.5 rounded-[var(--radius-pill)] border border-[var(--color-glass-border)] text-on-surface font-semibold text-sm md:text-base bg-transparent hover:bg-[var(--color-glass-bg-hover)] transition-all duration-300 hover:-translate-y-0.5"
        data-magnetic-strength="5"
      >
        Ver Proceso
      </a>
    </div>
  </div>

  <!-- ─── Scroll Indicator (bouncing dot) ─── -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-xs font-medium text-on-surface-variant tracking-widest uppercase">Scroll</span>
    <div class="scroll-indicator w-5 h-8 rounded-full border border-on-surface-variant/40 flex justify-center pt-1.5">
      <div class="scroll-dot w-1 h-1.5 rounded-full bg-on-surface-variant"></div>
    </div>
  </div>
</section>