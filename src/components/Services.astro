---
interface Service {
  label: string;
  title: string;
  description: string;
  outputs: readonly string[];
}

const services = [
  {
    label: 'Operación',
    title: 'Sistemas prácticos para el negocio',
    description: 'Herramientas que ordenan tareas reales sin sumar complejidad innecesaria.',
    outputs: ['Inventario y ventas', 'Flujos administrativos', 'Herramientas web a medida'],
  },
  {
    label: 'Presencia',
    title: 'Sitios, identidad y posicionamiento',
    description: 'Una presencia digital clara para explicar qué hacés, generar confianza y facilitar el próximo paso.',
    outputs: ['Sitios web', 'Identidad visual', 'Contenido y posicionamiento'],
  },
  {
    label: 'Puesta en marcha',
    title: 'Equipos, configuración e instalación',
    description: 'Cuando la solución necesita hardware, GoDigital también puede buscarlo, configurarlo e integrarlo.',
    outputs: ['Búsqueda transparente', 'Configuración', 'Instalación completa'],
  },
  {
    label: 'Entrega',
    title: 'Un responsable de principio a fin',
    description: 'Las decisiones de negocio, diseño, tecnología y puesta en marcha se coordinan como una sola entrega.',
    outputs: ['Alcance entendible', 'Ejecución hands-on', 'Decisiones explicadas'],
  },
] satisfies readonly Service[];
---

<section class="services section" id="services" aria-labelledby="services-title">
  <div class="page-shell services__layout">
    <header class="services__intro">
      <p class="document-label">Capacidades de entrega</p>
      <h2 id="services-title">Lo digital se diseña alrededor del negocio, no al revés.</h2>
      <p>
        GoDigital combina estrategia, diseño, desarrollo y puesta en marcha para resolver lo que el proyecto realmente necesita.
      </p>
      <aside class="scope-note">
        <span class="scope-note__mark" aria-hidden="true">*</span>
        El alcance se conversa y se documenta. No se infla para parecer más grande.
      </aside>
    </header>

    <ol class="service-ledger">
      {services.map((service) => (
        <li data-motion="line">
          <div class="service-ledger__label document-label">{service.label}</div>
          <div class="service-ledger__copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <ul class="service-ledger__outputs" aria-label={`Incluye ${service.title}`}>
            {service.outputs.map((output) => <li>{output}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
