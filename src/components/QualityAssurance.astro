---
interface Principle {
  prompt: string;
  answer: string;
}

const principles = [
  {
    prompt: '¿Qué problema estamos resolviendo?',
    answer: 'La necesidad del negocio se escribe antes de elegir herramientas o equipos.',
  },
  {
    prompt: '¿Qué incluye la entrega?',
    answer: 'Sistema, presencia digital, equipamiento o instalación quedan separados y entendibles.',
  },
  {
    prompt: '¿Qué hace falta para usarla?',
    answer: 'La puesta en marcha forma parte de la conversación, no se deja como sorpresa para el cliente.',
  },
  {
    prompt: '¿Por qué se tomó cada decisión?',
    answer: 'Las decisiones importantes se explican con relación al negocio, al presupuesto y al contexto.',
  },
] satisfies readonly Principle[];
---

<section class="principles section" id="principles" aria-labelledby="principles-title">
  <div class="page-shell principles__layout">
    <header class="principles__intro">
      <p class="document-label">Criterios de entrega</p>
      <h2 id="principles-title">Lo importante tiene que poder revisarse.</h2>
      <p>
        Una entrega premium no necesita esconderse detrás de palabras técnicas. Tiene que dejar claro qué se resolvió y cómo se llegó hasta ahí.
      </p>
      <div class="inspection-stamp" data-motion="stamp" aria-hidden="true">
        Inspeccionable
      </div>
    </header>

    <div class="principle-register" role="list">
      {principles.map((principle) => (
        <article role="listitem" data-motion="line">
          <span class="principle-register__mark" aria-hidden="true">✓</span>
          <div>
            <h3>{principle.prompt}</h3>
            <p>{principle.answer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
