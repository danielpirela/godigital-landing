---
---

<section
  id="cta"
  class="relative px-[var(--margin-mobile)] md:px-[var(--margin-desktop)] pb-30"
  data-reveal="cta"
>
  <div class="mx-auto" style="max-width: var(--container-max);">
    <div
      class="glass-card p-10 md:p-16 lg:p-20 text-center relative overflow-hidden"
    >
      <!-- Background glow orb -->
      <div
        class="absolute -top-[200px] left-1/2 -translate-x-1/2 w-[500px] h-[500px] rounded-full pointer-events-none"
        style="background: radial-gradient(circle, rgba(0, 102, 255, 0.08) 0%, transparent 70%); filter: blur(80px);"
      ></div>

      <div class="relative z-10">
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          ¿Listo para digitalizar<br class="hidden sm:inline" /> tu <span class="text-primary">visión</span>?
        </h2>
        <p class="text-on-surface-variant text-base md:text-lg max-w-lg mx-auto mb-10 md:mb-12">
          Damos vida a tus ideas con diseño y desarrollo de primer nivel. Hablemos de tu próximo proyecto.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
          <a
            href="#cta"
            class="cta-btn inline-flex items-center justify-center px-10 py-4 rounded-[var(--radius-pill)] bg-primary text-white font-semibold text-base glow-primary hover:glow-primary-hover transition-all duration-300 hover:-translate-y-0.5"
          >
            Cotizar Proyecto
          </a>
          <a
            href="#process"
            class="cta-btn inline-flex items-center justify-center px-10 py-4 rounded-[var(--radius-pill)] border border-[var(--color-glass-border)] text-on-surface font-semibold text-base bg-transparent hover:bg-[var(--color-glass-bg-hover)] transition-all duration-300 hover:-translate-y-0.5"
          >
            Ver Proceso
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
