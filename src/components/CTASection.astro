---
import GlassCard from './GlassCard.astro';

/**
 * CTASection.astro — v3 watermark + glass pricing card
 *
 * Watermark "Diseñamos. / Construimos." behind a strong GlassCard.
 * 3-tier pricing structure: Consulta inicial (free),
 * Proyecto típico (placeholder), A medida (Hablemos CTA).
 */
---

<section
  id="cta"
  class="relative px-[var(--margin-mobile)] md:px-[var(--margin-desktop)] py-20 md:py-32 overflow-hidden"
  data-reveal="cta"
>
  <!-- Parallax depth background -->
  <div class="cta-bg absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Breathing orbs -->
    <div class="cta-orb cta-orb-1 absolute -top-[120px] left-[10%] w-[400px] h-[400px] rounded-full opacity-40"
         style="background: radial-gradient(circle, rgba(0, 102, 255, 0.15) 0%, transparent 70%); filter: blur(var(--orb-blur, 80px));"></div>
    <div class="cta-orb cta-orb-2 absolute top-[20%] -right-[100px] w-[500px] h-[500px] rounded-full opacity-30"
         style="background: radial-gradient(circle, rgba(0, 102, 255, 0.1) 0%, transparent 70%); filter: blur(var(--orb-blur, 80px));"></div>
    <div class="cta-orb cta-orb-3 absolute -bottom-[80px] left-[30%] w-[350px] h-[350px] rounded-full opacity-20"
         style="background: radial-gradient(circle, rgba(0, 102, 255, 0.08) 0%, transparent 70%); filter: blur(var(--orb-blur, 80px));"></div>

    <!-- Mesh gradient overlay -->
    <div class="absolute inset-0 mesh-gradient opacity-60"></div>
  </div>

  <!-- Watermark: behind the card, z-index 2 -->
  <div class="c3-watermark-container" aria-hidden="true">
    <div class="c3-watermark-main">
      <span class="c3-watermark-line-1">Diseñamos.</span>
      <span class="c3-watermark-line-2">Construimos.</span>
    </div>
  </div>

  <div class="mx-auto relative z-10" style="max-width: var(--container-max);">

    <!-- 3-tier pricing card wrapped in strong GlassCard -->
    <GlassCard variant="strong" padding="lg" as="section" id="cta" class="cta-glass-card">
      <div class="relative z-10">

        <!-- Scroll-scrubbed counter badge -->
        <div
          class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full mb-8 md:mb-10"
          style="background: var(--color-glass-bg); border: 1px solid var(--color-glass-border); backdrop-filter: blur(12px);"
        >
          <!-- Animated orb dot -->
          <span class="cta-counter-dot w-2.5 h-2.5 rounded-full bg-primary inline-block"
                style="box-shadow: 0 0 8px rgba(0, 102, 255, 0.8);"></span>
          <span
            class="text-sm md:text-base font-medium text-on-surface-variant"
            aria-live="polite"
          >
            <span
              class="cta-counter font-semibold text-primary"
              data-counter-target="10"
              data-counter-suffix="+ proyectos completados"
            >0+ proyectos completados</span>
          </span>
        </div>

        <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 md:mb-8">
          ¿Listo para digitalizar<br class="hidden sm:inline" /> tu <span class="text-primary">visión</span>?
        </h2>
        <p class="text-on-surface-variant text-base md:text-lg max-w-lg mx-auto mb-10 md:mb-12">
          Damos vida a tus ideas con diseño y desarrollo de primer nivel. Hablemos de tu próximo proyecto.
        </p>

        <!-- 3-tier pricing grid -->
        <div class="cta-tiers-grid mb-10 md:mb-12">

          <!-- Tier 1: Consulta inicial (free) -->
          <div class="cta-tier cta-tier--free">
            <div class="cta-tier-header">
              <span class="cta-tier-heading">Consulta inicial</span>
              <span class="cta-tier-price">Gratis</span>
            </div>
            <p class="cta-tier-sub">30 minutos sin compromiso</p>
            <ul class="cta-tier-bullets">
              <li>Conocemos tu proyecto</li>
              <li>Te decimos si podemos ayudar</li>
              <li>Sin presión comercial</li>
              <li>Quedás con un roadmap inicial</li>
            </ul>
          </div>

          <!-- Tier 2: Proyecto típico -->
          <div class="cta-tier cta-tier--standard">
            <div class="cta-tier-header">
              <span class="cta-tier-heading">Proyecto típico</span>
              <span class="cta-tier-price">A medida</span>
            </div>
            <p class="cta-tier-sub">Sitio web institucional o landing</p>
            <ul class="cta-tier-bullets">
              <li>4-6 semanas de desarrollo</li>
              <li>Diseño a medida</li>
              <li>Deploy + analytics</li>
              <li>30 días de soporte incluidos</li>
            </ul>
          </div>

          <!-- Tier 3: A medida (highlighted) -->
          <div class="cta-tier cta-tier--pro">
            <div class="cta-tier-badge">Recomendado</div>
            <div class="cta-tier-header">
              <span class="cta-tier-heading">A medida</span>
              <span class="cta-tier-price">Hablemos</span>
            </div>
            <p class="cta-tier-sub">E-commerce, SaaS, plataformas</p>
            <ul class="cta-tier-bullets">
              <li>Roadmap a tu medida</li>
              <li>Equipo dedicado</li>
              <li>Iteración continua</li>
              <li>Soporte prioritario</li>
            </ul>
            <a
              href="mailto:hola@godigital.com.ar"
              class="cta-tier-cta liquid-glass liquid-glass--accent mt-6 inline-flex items-center justify-center px-8 py-3 rounded-[var(--radius-pill)] font-semibold text-base text-white transition-all duration-300"
              data-magnetic-strength="0.4"
            >
              Hablemos
              <span aria-hidden="true" class="ml-2">→</span>
            </a>
          </div>

        </div>

        <!-- Secondary stats row -->
        <div
          class="mt-12 md:mt-16 pt-8 md:pt-10 grid grid-cols-3 gap-6 md:gap-8 max-w-xl mx-auto"
          style="border-top: 1px solid var(--color-glass-border);"
        >
          <div class="text-center">
            <div
              class="text-2xl md:text-3xl font-bold text-primary"
              aria-live="polite"
            >
              <span class="cta-counter-2" data-counter-target="8" data-counter-suffix="+">0+</span>
            </div>
            <div class="text-xs md:text-sm text-on-surface-variant mt-1">Años de experiencia</div>
          </div>
          <div class="text-center" style="border-left: 1px solid var(--color-glass-border); border-right: 1px solid var(--color-glass-border);">
            <div
              class="text-2xl md:text-3xl font-bold text-primary"
              aria-live="polite"
            >
              <span class="cta-counter-3" data-counter-target="50" data-counter-suffix="+">0+</span>
            </div>
            <div class="text-xs md:text-sm text-on-surface-variant mt-1">Proyectos entregados</div>
          </div>
          <div class="text-center">
            <div
              class="text-2xl md:text-3xl font-bold text-primary"
              aria-live="polite"
            >
              <span class="cta-counter-4" data-counter-target="100" data-counter-suffix="%">0%</span>
            </div>
            <div class="text-xs md:text-sm text-on-surface-variant mt-1">Satisfacción del cliente</div>
          </div>
        </div>
      </div>
    </GlassCard>
  </div>
</section>

<style>
  /* CTA GlassCard sits above the watermark */
  .cta-glass-card {
    position: relative;
    z-index: 10;
  }

  /* Breathing animation for orbs */
  .cta-orb {
    will-change: transform;
  }

  .cta-orb-1 {
    animation: breathing 4s ease-in-out infinite;
  }

  .cta-orb-2 {
    animation: breathing 5s ease-in-out infinite;
    animation-delay: -1s;
  }

  .cta-orb-3 {
    animation: breathing 4.5s ease-in-out infinite;
    animation-delay: -2s;
  }

  @keyframes breathing {
    0%, 100% { transform: scale(0.9); }
    50% { transform: scale(1.1); }
  }

  /* Counter dot pulse */
  .cta-counter-dot {
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(0, 102, 255, 0.8); }
    50% { opacity: 0.6; box-shadow: 0 0 16px rgba(0, 102, 255, 1); }
  }

  /* 3-tier grid */
  .cta-tiers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cta-tiers-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  /* Individual tier card */
  .cta-tier {
    position: relative;
    padding: 1.5rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cta-tier--pro {
    background: rgba(0, 102, 255, 0.06);
    border: 1px solid rgba(0, 102, 255, 0.25);
    border-top: 2px solid var(--color-primary);
  }

  /* Pro badge */
  .cta-tier-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 12px;
    border-radius: 20px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Tier header row */
  .cta-tier-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .cta-tier-heading {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
  }

  .cta-tier-price {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-on-surface);
  }

  .cta-tier--pro .cta-tier-price {
    color: var(--color-primary);
  }

  /* Sub text */
  .cta-tier-sub {
    font-size: 13px;
    color: var(--color-on-surface-variant);
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }

  /* Bullets */
  .cta-tier-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cta-tier-bullets li {
    font-size: 13px;
    color: var(--color-on-surface-variant);
    padding-left: 1rem;
    position: relative;
    opacity: 0.8;
  }

  .cta-tier-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-size: 11px;
    top: 2px;
  }

  /* Hablemos button */
  .cta-tier-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    margin-top: auto;
    transition: transform 0.3s var(--ease-cinematic), box-shadow 0.3s var(--ease-cinematic);
  }

  .cta-tier-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 102, 255, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  /* CTA button hover states */
  .cta-primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 60px rgba(0, 102, 255, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .cta-secondary-btn:hover {
    transform: translateY(-2px);
    background: var(--color-glass-bg-hover);
  }

  /* Counter dot flex */
  .cta-counter-dot {
    flex-shrink: 0;
  }
</style>