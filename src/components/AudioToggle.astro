---
// AudioToggle — NO-OP stub (icon-only speaker button)
//
// Audio is disabled for SEO per user decision 2026-06-03.
// This stub exists as a placeholder for future audio integration.
// Hidden via data-audio-stub="true" attribute.
//
// Only renders when prefers-reduced-motion is NOT active.
---

<button
  type="button"
  class="audio-toggle"
  id="audio-toggle"
  data-audio-stub="true"
  aria-label="Activar audio"
  title="Audio (pendiente)"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <!-- Speaker icon (placeholder — no audio attached) -->
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
    <line x1="23" y1="9" x2="17" y2="15" />
    <line x1="17" y1="9" x2="23" y2="15" />
  </svg>
</button>

<style>
  .audio-toggle {
    display: none; /* Hidden by default — no audio source attached */
  }
</style>