---
import { CONTACT_CHANNELS } from '../lib/contact';

const currentYear = new Date().getFullYear();

const links = [
  { href: '#case-file', label: 'Caso real' },
  { href: '#services', label: 'Servicios' },
  { href: '#method', label: 'Cómo entregamos' },
  { href: '#principles', label: 'Criterios' },
  { href: '#contact', label: 'Contacto' },
];
---

<footer class="site-footer">
  <div class="page-shell site-footer__layout">
    <div class="site-footer__brand">
      <a href="#top" aria-label="GoDigital, ir al inicio">
        <img src="/logo-dark.svg" alt="GoDigital" width="176" height="46" />
      </a>
      <p>Tecnología accesible, entrega responsable y trato directo.</p>
    </div>

    <nav aria-label="Navegación del pie">
      <p class="document-label">Índice</p>
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__contact">
      <p class="document-label">Contacto verificado</p>
      <a
        class="site-footer__primary-contact"
        href={CONTACT_CHANNELS.whatsapp.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Hablar con GoDigital por WhatsApp, abre en una pestaña nueva"
      >
        Hablar por WhatsApp
        <span aria-hidden="true">↗</span>
      </a>
      <a class="site-footer__email" href={CONTACT_CHANNELS.email.projectHref}>
        {CONTACT_CHANNELS.email.address}
      </a>
      <span>Atención en español para Latinoamérica</span>
    </div>

    <div class="site-footer__social">
      <p class="document-label">Presencia verificada</p>
      <ul>
        {CONTACT_CHANNELS.social.map((channel) => (
          <li>
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${channel.label} de GoDigital, abre en una pestaña nueva`}
            >
              {channel.label}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="page-shell site-footer__base">
    <p>© {currentYear} GoDigital</p>
    <p>Hecho para emprendedores que están construyendo algo propio.</p>
  </div>
</footer>
