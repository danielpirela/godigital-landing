---
interface MethodStep {
  number: string;
  title: string;
  description: string;
  evidence: string;
}

const steps = [
  {
    number: '01',
    title: 'Entender la operación',
    description: 'Empezamos por cómo trabajás hoy, qué te frena, con qué presupuesto contás y qué necesitás poner en marcha.',
    evidence: 'Salida: necesidad documentada',
  },
  {
    number: '02',
    title: 'Definir una solución posible',
    description: 'Ordenamos qué hace falta, qué no, y cómo se conectan el sistema, la presencia digital o el equipamiento.',
    evidence: 'Salida: alcance entendible',
  },
  {
    number: '03',
    title: 'Construir y poner en marcha',
    description: 'Diseñamos, desarrollamos, buscamos o configuramos lo necesario y coordinamos la implementación completa.',
    evidence: 'Salida: solución operativa',
  },
  {
    number: '04',
    title: 'Entregar con claridad',
    description: 'Cerramos la entrega con una solución usable y las decisiones importantes explicadas de forma directa.',
    evidence: 'Salida: entrega inspeccionable',
  },
] satisfies readonly MethodStep[];
---

<section class="method section" id="method" aria-labelledby="method-title">
  <div class="page-shell method__layout">
    <header class="method__intro">
      <p class="document-label">Registro de decisiones</p>
      <h2 id="method-title">Cada etapa tiene una pregunta y una salida concreta.</h2>
      <p>La claridad no se agrega al final. Es parte de cómo se define y se entrega el proyecto.</p>
    </header>

    <ol class="method-log">
      {steps.map((step) => (
        <li data-motion="sheet">
          <span class="method-log__number">{step.number}</span>
          <div class="method-log__copy">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
          <p class="method-log__evidence document-label">{step.evidence}</p>
          <span class="method-log__check" aria-hidden="true">✓</span>
        </li>
      ))}
    </ol>
  </div>
</section>
