---
import { CONTACT_CHANNELS } from '../lib/contact';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GoDigital | Sistemas y presencia digital para emprendedores',
  description = 'Creamos sistemas prácticos, sitios web y soluciones digitales completas para emprendedores y pequeños negocios en Latinoamérica.',
} = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GoDigital',
  description,
  email: CONTACT_CHANNELS.email.address,
  areaServed: 'Latin America',
  availableLanguage: 'Spanish',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'project inquiries',
    url: CONTACT_CHANNELS.whatsapp.href,
    areaServed: 'Latin America',
    availableLanguage: 'es',
  },
  sameAs: CONTACT_CHANNELS.social.map((channel) => channel.href),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1746d1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/logo-base.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GoDigital" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Azeret+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
  </body>
</html>
