---
import '../styles/global.css';
import SectionProgress from '../components/SectionProgress.astro';
import AudioToggle from '../components/AudioToggle.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'GoDigital — Diseño y desarrollo premium', description = 'Transformamos tu visión en productos digitales excepcionales. Diseño UX/UI, desarrollo web, apps móviles y SEO técnico.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Dark theme -->
    <meta name="theme-color" content="#06080d" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />

    <!-- v2: Hero poster preload for fast LCP -->
    <link rel="preload" as="image" href="/assets/generated/bg/obsidian-mesh.png" />

    <!-- v2: ENABLE_V2_ANIM type declaration + runtime bridge -->
    <script is:inline>
      // Vite define replacement — will be 'true' or 'false' string at build time
      window.__ENABLE_V2_ANIM__ = typeof __ENABLE_V2_ANIM__ !== 'undefined'
        ? __ENABLE_V2_ANIM__ === 'true'
        : true;
    </script>
  </head>
  <body class="bg-surface-dim text-on-surface antialiased overflow-x-hidden">
    <SectionProgress />
    <AudioToggle />
    <slot />
  </body>
</html>