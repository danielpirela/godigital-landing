---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import FounderNote from '../components/FounderNote.astro';
import QualityAssurance from '../components/QualityAssurance.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<!--
THESIS: GoDigital proves complete delivery through one inspectable entrepreneur case and rejects the generic claim-first agency page.
OWN-WORLD: Cobalt blueprint fields, warm drafting paper, graphite rules, redlines, tabs, checklists, and redacted project sheets.
STORY: A founder sees a real operating problem resolved end to end, understands the available capabilities and method, then starts a direct conversation.
FIRST VIEWPORT: A cobalt editorial proposition occupies the left; the anonymized delivery dossier is tangible proof on the right; the WhatsApp action is visible beside it.
FORM: Delivery Dossier, human-selected replacement world; asymmetric dossier staging; no concept seed was run.
-->

<Layout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <CaseStudy />
    <Services />
    <Process />
    <FounderNote />
    <QualityAssurance />
    <CTASection />
  </main>
  <Footer />
</Layout>

<script>
  import { initSite } from '../scripts/site';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSite, { once: true });
  } else {
    initSite();
  }
</script>
